      <button class="btn btn-ghost" onclick="fecharModal('modal-nfe')">Cancelar</button>
      <button class="btn btn-primary" onclick="enviarNFe()">📤 Enviar para SEFAZ</button>
    </div>
  </div>
</div>

<!-- Modal Config NF-e -->
<div id="modal-config-nfe" class="modal-overlay">
  <div class="modal" style="max-width:480px">
    <div class="modal-header">
      <h3>⚙️ Configuração do Servidor PHP</h3>
      <button class="btn-fechar" onclick="fecharModal('modal-config-nfe')">✕</button>
    </div>
    <div class="modal-body">
      <div class="info-box">Configure o endereço do seu servidor PHP (Hostinger) que processará a NF-e com NFePHP.</div>
      <div class="form-group">
        <label class="form-label">URL do servidor PHP *</label>
        <input type="url" class="form-control" id="cfg-nfe-url" placeholder="https://seudominio.com.br/estoque/nfe/emitir.php">
      </div>
      <div class="form-group">
        <label class="form-label">Token de autenticação (opcional)</label>
        <input type="text" class="form-control" id="cfg-nfe-token" placeholder="Token secreto">
      </div>
      <div class="aviso-box" style="margin-top:8px">
        <strong>Próximos passos:</strong><br>
        1. Instale o NFePHP no Hostinger via Composer<br>
        2. Suba seu certificado .pfx para pasta <code>/estoque/nfe/certs/</code><br>
        3. Configure emitir.php com CNPJ e senha do certificado
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="fecharModal('modal-config-nfe')">Cancelar</button>
      <button class="btn btn-primary" onclick="salvarConfigNFe()">Salvar Configuração</button>
    </div>
  </div>
</div>

